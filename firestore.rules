rules_version = '2';

// Phase 4 -- ownership + role model.
//
// Phase 1 (see git history) closed the front door: every read/write needs
// request.auth != null. That was enough to stop the public internet from
// touching the database, but it left every signed-in user able to read AND
// WRITE every other user's donations and requests. This revision fixes that:
// a donor can only create/change/delete their own donation, a requester can
// only create/change/delete their own request, nobody can grant themselves
// a role (including admin), and admin-only actions (changing someone else's
// role, suspending an account, running the cross-donor matching engine) are
// enforced here, not just hidden in the UI.
//
// Design note on the matching engine: `runFulfillment()` in firebase-app.js
// necessarily mutates OTHER people's donations (decrementing quantity as it
// allocates) and moves OTHER people's requests between collections. Under a
// strict per-owner model that can only be a privileged operation, so Phase 4
// restricts triggering it to admins (see IMPLEMENTATION_PLAN.md) -- the admin
// bypass below (`isAdmin()`) is what makes that legal without reopening
// cross-owner writes to everyone. This is a documented scope decision, not
// an oversight.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // The signed-in user's own profile document, read once per rule
    // evaluation. get() on a document that doesn't exist causes the calling
    // rule to evaluate to false rather than throwing past it, which is the
    // behavior we want: no profile yet -> no role -> denied.
    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    // NOT `isSignedIn() && myProfile().role` -- Firestore Rules' `&&` requires
    // BOTH sides to be boolean (unlike JS, it doesn't return "whichever value
    // made it true"), so that form throws "Type error. Received: [string]
    // Expected: [bool]" the moment a signed-in user actually has a role
    // string to return. The ternary form doesn't have that constraint.
    function myRole() {
      return isSignedIn() ? myProfile().role : null;
    }
    function isAdmin() {
      return isSignedIn() && myProfile().role == 'admin';
    }
    // Suspended accounts keep read access (so they can see their own history
    // and know what happened) but lose every write.
    function isActiveWriter() {
      return isSignedIn() && myProfile().suspended != true;
    }
    function isOwner(data) {
      return isSignedIn() && data.ownerId == request.auth.uid;
    }
    function unchanged(field) {
      return request.resource.data[field] == resource.data[field];
    }

    // One profile document per signed-in user, created client-side on first
    // sign-in (see ensureUserProfile in firebase-app.js). Role starts
    // unset ('member') and is claimed once by the user themself (donor,
    // requester, or volunteer -- never admin, see the claimRole transition
    // below); after that, only an admin can change it, and never their own.
    match /users/{userId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn() && request.auth.uid == userId
                    && request.resource.data.role == 'member'
                    && request.resource.data.suspended == false;

      allow update: if isSignedIn() && (
        // The user claims their own role exactly once, member -> donor,
        // requester, or volunteer. They can never touch `suspended`
        // themselves, and this path can never produce 'admin'.
        (request.auth.uid == userId
          && resource.data.role == 'member'
          && request.resource.data.role in ['donor', 'requester', 'volunteer']
          && unchanged('suspended'))
        ||
        // The user edits their own non-protected fields (e.g. display info
        // added later) -- role and suspended state must stay exactly as they
        // were; a user can never grant or revoke their own access this way.
        (request.auth.uid == userId
          && unchanged('role')
          && unchanged('suspended'))
        ||
        // An admin manages another user's role/suspension -- never their own
        // account through this path, so an admin can't accidentally (or
        // maliciously) demote or suspend themselves out of the console, and
        // "make myself admin" is structurally impossible: the only way to
        // reach role == 'admin' is an *existing* admin setting it on someone
        // ELSE's document.
        (isAdmin() && request.auth.uid != userId)
      );

      allow delete: if false;
    }

    // Legacy donor registry (one doc per donor "profile" -- pre-dates the
    // users/{uid} role system and is still what donations.donorId points
    // at). Now ownership-scoped: a donor-role user manages exactly the
    // donor record(s) they created (ownerId == their uid).
    match /donors/{donorId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isActiveWriter()
                    && myRole() == 'donor'
                    && request.resource.data.ownerId == request.auth.uid;
      allow update: if isSignedIn() && isActiveWriter()
                    && (isOwner(resource.data) || isAdmin())
                    && unchanged('ownerId');
      allow delete: if isSignedIn() && (isOwner(resource.data) || isAdmin());
    }

    match /donations/{donationId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isActiveWriter()
                    && myRole() == 'donor'
                    && request.resource.data.ownerId == request.auth.uid;
      // Owner edits their own donation; admin edits any donation (this is
      // also the path the matching engine's batch quantity/status updates
      // use, since it runs as an admin -- see the design note above).
      allow update: if isSignedIn() && isActiveWriter()
                    && (isOwner(resource.data) || isAdmin())
                    && unchanged('ownerId');
      allow delete: if isSignedIn() && (isOwner(resource.data) || isAdmin());
    }

    // Requests carry the requester's uid as ownerId directly on the
    // document (there's no separate "requesters" registry the way there is
    // for donors). requests_pending / requests_fulfilled are only ever
    // written by the matching engine moving a request out of the urgent
    // queue, which is an admin-triggered action (see design note above) --
    // so creation there is admin-only, while the ORIGINAL owner is still
    // preserved as ownerId on the moved document and can read/manage it
    // afterwards.
    match /requests_urgent/{requestId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isActiveWriter()
                    && myRole() == 'requester'
                    && request.resource.data.ownerId == request.auth.uid;
      allow update: if isSignedIn() && isActiveWriter()
                    && (isOwner(resource.data) || isAdmin())
                    && unchanged('ownerId');
      allow delete: if isSignedIn() && (isOwner(resource.data) || isAdmin());
    }
    match /requests_pending/{requestId} {
      allow read: if isSignedIn();
      allow create: if isAdmin();
      allow update: if isSignedIn() && isActiveWriter()
                    && (isOwner(resource.data) || isAdmin())
                    && unchanged('ownerId');
      allow delete: if isSignedIn() && (isOwner(resource.data) || isAdmin());
    }
    match /requests_fulfilled/{requestId} {
      allow read: if isSignedIn();
      allow create: if isAdmin();
      allow update: if isSignedIn() && isActiveWriter()
                    && (isOwner(resource.data) || isAdmin())
                    && unchanged('ownerId');
      allow delete: if isAdmin();
    }

    // ---- Phase 5: account verification ------------------------------------
    // One doc per user (verifications/{uid}). No doc yet means "unverified" --
    // that state isn't persisted, it's just the absence of a submission. A
    // donor/requester submits their own (create, status forced to 'pending')
    // and may resubmit after a rejection (update, 'rejected' -> 'pending'),
    // but can never write 'verified' themselves and can never touch the
    // admin-owned review fields (reviewedBy/reviewedAt/reviewNote). Only an
    // admin can move a submission to 'verified' or 'rejected', and -- same
    // self-action guard as the role/suspension rules above -- never their own.
    match /verifications/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());

      allow create: if isSignedIn() && isActiveWriter()
                    && request.auth.uid == uid
                    && myRole() in ['donor', 'requester']
                    && request.resource.data.ownerId == uid
                    && request.resource.data.status == 'pending';

      allow update: if isSignedIn() && (
        (request.auth.uid == uid && isActiveWriter()
          && resource.data.status == 'rejected'
          && request.resource.data.status == 'pending'
          && unchanged('ownerId')
          && unchanged('reviewedBy') && unchanged('reviewedAt') && unchanged('reviewNote'))
        ||
        (isAdmin() && request.auth.uid != uid
          && resource.data.status == 'pending'
          && request.resource.data.status in ['verified', 'rejected']
          && unchanged('ownerId'))
      );

      allow delete: if false;
    }

    // ---- Phase 6: delivery workflow ----------------------------------------
    // One doc per fulfilled request (deliveries/{deliveryId}), created by the
    // matching engine (admin-triggered, same as requests_fulfilled -- see the
    // design note at the top of this file) in status 'AVAILABLE' with
    // volunteerId == null: an open job any active volunteer can pick up.
    //
    // State machine: AVAILABLE -> RESERVED -> PICKED_UP -> DELIVERING ->
    // DELIVERED. The first transition (claiming) is open to any volunteer
    // and assigns them as volunteerId; every transition after that belongs
    // exclusively to whichever volunteer claimed it (or an admin, same
    // override pattern as everywhere else in this file). Nobody can skip a
    // state -- each `allow update` clause below names the one specific
    // fromStatus -> toStatus pair it permits, so e.g. writing 'DELIVERED'
    // straight from 'RESERVED' matches none of them and is denied.
    // Immutable identity fields (requestId, donorOwnerId, requesterOwnerId)
    // can never change once the job exists, by anyone, including admins.
    function deliveryIdentityUnchanged() {
      return unchanged('requestId') && unchanged('donorOwnerId') && unchanged('requesterOwnerId');
    }
    match /deliveries/{deliveryId} {
      allow read: if isSignedIn();

      allow create: if isAdmin()
                    && request.resource.data.status == 'AVAILABLE'
                    && request.resource.data.volunteerId == null;

      allow update: if isSignedIn() && (
        // Claim: any active volunteer can take an unclaimed job. Firestore
        // rules are evaluated against the live server document at write
        // time, so if two volunteers race for the same job the loser's
        // write is checked against the (by then) already-claimed document
        // and denied -- no transaction needed on the client for this to be
        // race-safe.
        (isActiveWriter() && myRole() == 'volunteer'
          && resource.data.status == 'AVAILABLE' && resource.data.volunteerId == null
          && request.resource.data.status == 'RESERVED'
          && request.resource.data.volunteerId == request.auth.uid
          && deliveryIdentityUnchanged())
        ||
        // Release (Phase 7c): the assigned volunteer can hand a still-
        // unpicked-up job back to the open pool if they can no longer do
        // it -- self-service, no admin override needed. Only from
        // RESERVED: once a job has moved to PICKED_UP, the volunteer
        // already has the food in hand, and "release" isn't a well-defined
        // state to hand back to an anonymous pool -- an admin override is
        // still available for that case, same as any other stuck job.
        (isActiveWriter() && request.auth.uid == resource.data.volunteerId
          && deliveryIdentityUnchanged()
          && resource.data.status == 'RESERVED'
          && request.resource.data.status == 'AVAILABLE'
          && request.resource.data.volunteerId == null)
        ||
        // Sequential progress: only the assigned volunteer, one step at a
        // time, volunteerId itself can never change once claimed.
        (isActiveWriter() && request.auth.uid == resource.data.volunteerId
          && unchanged('volunteerId') && deliveryIdentityUnchanged()
          && (
            (resource.data.status == 'RESERVED' && request.resource.data.status == 'PICKED_UP')
            || (resource.data.status == 'PICKED_UP' && request.resource.data.status == 'DELIVERING')
            || (resource.data.status == 'DELIVERING' && request.resource.data.status == 'DELIVERED')
          ))
        ||
        // Admin override -- can move a stuck job or fix a mistake, same
        // "trusted operator, still not a free-for-all" role every admin
        // bypass in this file plays. Identity fields still can't move.
        (isAdmin() && deliveryIdentityUnchanged())
      );

      allow delete: if isAdmin();
    }

    // ---- Phase 5: audit log -------------------------------------------------
    // Append-only -- nobody, including admins, can update or delete an entry
    // once it's written. Every entry must be filed by the person who did the
    // thing (actorId has to equal the writer's own uid -- nobody can log an
    // action as if someone else did it), and the specific action named has
    // to match an authority the writer actually holds (only an admin can
    // file 'verification_approved', only a donor can file 'donation_created',
    // and so on).
    //
    // Stated plainly: this is a client-stamped log, not a server-enforced
    // one. There's no Cloud Functions layer in this project to be the sole,
    // trusted writer (see IMPLEMENTATION_PLAN.md), so "tamper-proof" here
    // means "nobody can rewrite or delete history, and nobody can claim an
    // authority -- like being an admin -- that their own role doesn't back up"
    // -- not "a client can never write a log entry about its own real
    // actions that didn't structurally have to happen." A fully tamper-proof
    // trail would move log writes server-side; that's out of scope here.
    function auditActorAuthorized(action) {
      return (
        (action in ['user_registered', 'role_assigned', 'verification_submitted'])
        || (action in ['verification_approved', 'verification_rejected',
                        'account_suspended', 'account_unsuspended', 'match_allocated'] && isAdmin())
        || (action in ['donation_created', 'donation_cancelled'] && myRole() == 'donor')
        || (action == 'request_created' && myRole() == 'requester')
        || (action in ['delivery_claimed', 'delivery_status_updated', 'delivery_released'] && myRole() == 'volunteer')
      );
    }
    match /audit_log/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn()
                    && request.resource.data.actorId == request.auth.uid
                    && auditActorAuthorized(request.resource.data.action);
      allow update, delete: if false;
    }

    // ---- Phase 7: notifications ---------------------------------------------
    // One doc per notification, notifications/{id}, addressed to a single
    // recipient (userId). Same client-stamped trust model as audit_log
    // (Phase 5) -- not server-enforced, but nobody can claim an authority
    // their own role doesn't back up, and nobody can forge a notification
    // as if it came from someone else's action.
    //
    // All three notification-producing actions in this app already run as
    // an admin (runFulfillment, setVerificationStatus -- see the design
    // note at the top of this file), so creation here is admin-only,
    // scoped further by type:
    //   - 'request_fulfilled'    -> any recipient (the requester whose
    //     request the matching engine just fulfilled).
    //   - 'verification_reviewed' -> any recipient except the admin
    //     themself (mirrors the self-review guard on verifications/{uid}).
    //   - 'delivery_available'   -> recipient must actually hold the
    //     'volunteer' role (checked with the same get()-based pattern as
    //     myProfile() above) -- an admin can't spam an arbitrary uid.
    function recipientRole(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.role;
    }
    function notifActorAuthorized(type, recipientId) {
      return (
        (type == 'request_fulfilled' && isAdmin())
        || (type == 'verification_reviewed' && isAdmin() && request.auth.uid != recipientId)
        || (type == 'delivery_available' && isAdmin() && recipientRole(recipientId) == 'volunteer')
      );
    }
    match /notifications/{notifId} {
      // Only the recipient can read their own notifications -- nobody
      // browses anyone else's inbox, including admins.
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;

      allow create: if isSignedIn()
                    && notifActorAuthorized(request.resource.data.type, request.resource.data.userId)
                    && request.resource.data.read == false;

      // The recipient can flip their own notification from unread to read
      // (never back to unread, never touch anything else about it) or
      // delete it outright to clear it from their list.
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid
                    && unchanged('userId') && unchanged('type') && unchanged('message')
                    && unchanged('targetId') && unchanged('targetType') && unchanged('createdAt')
                    && resource.data.read == false && request.resource.data.read == true;

      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Default deny -- anything not explicitly listed above is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
