rules_version = '2';

// Same access level as the "test mode" you already picked when creating the
// Firestore database in the console: open reads/writes for the demo.
// Fine for a portfolio project. If you ever want to lock it down, this is
// the file to tighten later (e.g. require auth, or make it read-only).
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
